# Puerto en el que corre el servidor
PORT=8080

# Clave secreta para firmar los tokens JWT (Cambiar en producción)
JWT_SECRET=super_secret_jwt_key_change_in_production

# URL de conexión a la base de datos (PostgreSQL/Supabase)
# Deja vacío para usar SQLite localmente
DATABASE_URL=

# Configuración de base de datos local (SQLite)
# DB_DRIVER=sqlite
# DB_SOURCE=./portfolio.db

# Credenciales y datos del administrador por defecto
ADMIN_DEFAULT_ID=1
ADMIN_DEFAULT_PASS=admin123
ADMIN_DEFAULT_NOMBRE=Marcos
ADMIN_DEFAULT_APELLIDOS=García
