PORT=8080
JWT_SECRET=super_secret_jwt_key_change_in_production

# Para PostgreSQL (Render, Supabase, Neon, Railway o Local):
DB_DRIVER=postgres
DB_SOURCE=postgres://usuario:password@localhost:5432/portfolio?sslmode=disable
# O simplemente define DATABASE_URL (Render y Supabase lo configuran automáticamente):
# DATABASE_URL=postgres://usuario:password@host:5432/dbname?sslmode=require

# Para SQLite (desarrollo local opcional):
# DB_DRIVER=sqlite
# DB_SOURCE=./portfolio.db

ADMIN_DEFAULT_ID=1
ADMIN_DEFAULT_PASS=admin123
ADMIN_DEFAULT_NOMBRE=Marcos
ADMIN_DEFAULT_APELLIDOS=García
